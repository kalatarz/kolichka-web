# Kolichka Web — Dev Server Configuration
# Copy this file to .env and fill in your values.

# Backend API server URL (proxied at /api)
API_PROXY_URL=http://localhost:3001

# Public-facing app URL (for og:url, canonical links, etc.)
APP_URL=https://kolichka.example.com

# Application display name
APP_NAME=Kolichka

# Optional: Discord community link
DISCORD_URL=

# Optional: Data source attribution link
DATA_SOURCE_URL=

# Contact emails (shown in UI footer)
FEEDBACK_EMAIL=
PRIVACY_EMAIL=

# Optional analytics (Umami-compatible)
# Leave empty to disable tracking entirely.
ANALYTICS_SCRIPT=
ANALYTICS_WEBSITE_ID=

# Optional FoodBase (foodbase.dev) nutrition integration.
# Server-side API key — NEVER commit a real value. When set, the server exposes
# GET /api/foodbase/search and the frontend shows the nutrition affordance.
# Leave empty to disable the feature entirely.
FOODBASE_API_KEY=
# Override only for self-hosted/mock FoodBase; default is the public API.
# FOODBASE_API_BASE=https://foodbase.dev/v1
# Keyless public-website fallback (foodbase.dev/products/search.json) used when
# the API key is missing or its daily quota is exhausted. Default on; set to
# "false" to require the API key. With this on, the feature works even with no key.
# FOODBASE_ALLOW_PUBLIC=true
